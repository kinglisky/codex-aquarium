{
  "name": "codex-aquarium",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node server/cli.mjs start",
    "stop": "node server/cli.mjs stop",
    "status": "node server/cli.mjs status",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm test && pnpm build",
    "package": "pnpm check && node scripts/package.mjs",
    "publish:distribution": "node scripts/publish-distribution.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
